# =========================================================
#  TALON — konfiguracja lokalna
# =========================================================
#  Wszystko jest ZAKOMENTOWANE. Odkomentuj tylko to, co chcesz zmienic —
#  reszta bierze wartosci domyslne zaszyte w kodzie.
#
#  Ten plik czyta run.sh. Format: KLUCZ=wartosc (bez spacji wokol '=').
#  Plik jest w .gitignore, wiec twoje ustawienia zostaja lokalne.
#
#  ---------------------------------------------------------
#  UWAGA — dwie kategorie ustawien:
#
#   [A] EGZEKWOWANE PRZEZ run.sh  → dzialaja od razu po odkomentowaniu.
#   [B] TYLKO REFERENCJA          → kod nie czyta plikow konfiguracyjnych,
#                                   wiec te wartosci trzeba zmienic w kodzie.
#                                   Podana jest dokladna linia. run.sh
#                                   przypomni, jesli je tu ustawisz.
# =========================================================


# =========================================================
#  [A] MODEL — egzekwowane przez run.sh
# =========================================================

# Nazwa pliku modelu w katalogu models/.
# src/main.cpp:37 laduje na sztywno "yolov8n.onnx", wiec jesli podasz inna
# nazwe, run.sh podstawi ja przez tymczasowy symlink o tej nazwie.
# Musi to byc model w formacie ONNX (.pt NIE zadziala — patrz README).
#MODEL=yolov8n.onnx

# Katalog z modelami (wzgledem korzenia projektu).
#MODELS_DIR=models


# =========================================================
#  [A] URUCHOMIENIE — egzekwowane przez run.sh
# =========================================================

# Typ budowania: Release (szybko, domyslnie) albo Debug (symbole, wolniej).
#BUILD_TYPE=Release

# Dodatkowe flagi przekazywane do CMake podczas konfiguracji.
#CMAKE_EXTRA_ARGS=


# =========================================================
#  [B] KAMERA — wymaga edycji main.cpp (include/Config.hpp)
# =========================================================

# Indeks kamery. 0 = wbudowana, 1 = pierwsza zewnetrzna, itd.
# Domyslnie: 0        → include/Config.hpp:31  (int camIndex = 0)
#CAM_INDEX=0

# Rozdzielczosc obrazu z kamery w pikselach.
# Domyslnie: 640x480  → include/Config.hpp:32-33  (int width / int height)
# Uwaga: fx jest przeliczane automatycznie przy zmianie rozdzielczosci
# (CameraParams::updateResolution), wiec samego fx zwykle nie ruszasz.
#CAM_WIDTH=640
#CAM_HEIGHT=480

# Poziomy kat widzenia obiektywu w stopniach. To NAJWAZNIEJSZY parametr
# dla dokladnosci pomiaru odleglosci — ustaw zgodnie ze swoja kamera.
# Domyslnie: 60.0     → include/Config.hpp:16  (double h_fov_deg)
#CAM_HFOV_DEG=60.0


# =========================================================
#  [B] DETEKCJA YOLO — wymaga edycji include/YoloDetector.hpp
# =========================================================

# Prog pewnosci detekcji [0.0-1.0]. Nizej = wiecej wykryc, wiecej falszywych.
# Domyslnie: 0.45     → include/YoloDetector.hpp:59  (float conf_threshold)
#CONF_THRESHOLD=0.45

# Prog NMS — odrzucanie nakladajacych sie ramek [0.0-1.0].
# Domyslnie: 0.45     → include/YoloDetector.hpp:60  (float nms_threshold)
#NMS_THRESHOLD=0.45


# =========================================================
#  [B] SLEDZENIE I GEOMETRIA — wymaga edycji src/main.cpp
# =========================================================

# Maksymalna odleglosc [m], przy ktorej nowa detekcja jest uznana za ten sam
# obiekt co juz sledzony (algorytm najblizszego sasiada).
# Domyslnie: 1.0      → src/main.cpp:110  (double MATCH_THRESHOLD)
#MATCH_THRESHOLD=1.0

# Zakladana rzeczywista szerokosc obiektu [m] dla klas spoza listy znanych.
# Uzywane do szacowania odleglosci ze wzoru Z = fx * W_real / w_piksele.
# Domyslnie: 0.30     → src/YoloDetector.cpp:27  (getRealWidthForClass, default)
#DEFAULT_REAL_WIDTH=0.30

# Minimalne pole konturu [px^2] — mniejsze sa ignorowane jako szum.
# Domyslnie: 700.0    → include/Config.hpp:34  (double minArea)
#MIN_AREA=700.0


# =========================================================
#  [B] SIATKA ZAJETOSCI — wymaga edycji src/main.cpp:43
# =========================================================

# Rozmiar komorki siatki [m] i maksymalny zasieg mapy [m].
# Domyslnie: 0.1 i 10.0  → src/main.cpp:43  (OccupancyGrid2D grid(0.1, 10.0))
#GRID_CELL_SIZE=0.1
#GRID_MAX_RANGE=10.0
